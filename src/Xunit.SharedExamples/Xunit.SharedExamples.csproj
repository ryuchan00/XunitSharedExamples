<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Xunit.SharedExamples</PackageId>
    <Version>0.1.0</Version>
    <Description>RSpec-style shared examples for xUnit.net v3, built on default interface methods. Declare a set of examples once as an interface, then include them in any number of test classes by implementing it.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" Version="$(XunitVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
